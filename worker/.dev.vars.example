# ============================================================
# 部署时无需填写任何密钥！
#
# · 后台账号密码：部署后访问 <你的地址>/admin，首次打开会引导你设置
# · 短信商密钥 / Turnstile Secret：登录后台 →「配置」标签里填写
#   （加密存入你自己的 D1 数据库，改完即时生效，无需重新部署）
#
# 本文件只用于本地开发（复制为 .dev.vars）。唯一可选项：
# ============================================================

# 调试模式：设为 1 时不发真实短信，验证码固定 123456
# 线上也可以在后台「配置 → 运行模式」里切换
MOCK_MODE=1
