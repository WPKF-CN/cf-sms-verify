# ============================================================
# 部署时会提示你填写这些值（复制本文件为 .dev.vars 可本地调试）
# ============================================================

# 后台登录密码的 SHA-256 哈希（不是明文密码！）
# 生成方式：npm run hash -- 你的密码
ADMIN_PASSWORD_HASH=

# 后台会话签名密钥，随便一串长随机字符
# 生成方式：openssl rand -hex 32
SESSION_SECRET=

# Cloudflare Turnstile 的 Secret Key（人机检测，可选但强烈建议）
# 获取：Cloudflare 控制台 → Turnstile → Add widget
TURNSTILE_SECRET=

# ─── Twilio Verify（要真发短信就必填这三项）───
# 获取：https://console.twilio.com → Account Info / Verify → Services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─── Plivo Verify（可选，需先联系 Plivo 开通）───
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_APP_UUID=
